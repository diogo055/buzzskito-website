# Amazon Associates tracking tag — PUBLIC (it appears in every affiliate link).
# Read at build time by lib/amazon.ts. This is the ONE place the tag is set.
#   • To change the ID: edit this value and redeploy.
#   • To fail-closed (zero Amazon links): set it empty and redeploy.
# A Vercel dashboard env var of the same name, if set, overrides this file.
PUBLIC_AMAZON_TAG=buzzskito200b-20
