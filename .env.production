# Amazon Associates tracking tag — PUBLIC (it appears in every affiliate link).
# Read at build time by lib/amazon.ts. This is the ONE place the tag is set.
#   • To change the ID: edit this value and redeploy.
#   • To fail-closed (zero Amazon links): set it empty and redeploy.
# A Vercel dashboard env var of the same name, if set, overrides this file.
PUBLIC_AMAZON_TAG=buzzskito200b-20

# amazon.com tracking tag for the US guides only (owner, Oct 20, 2026). PUBLIC, like the one above.
# Read at build time by lib/amazon.ts (store "com"). One page = one store: only the US guides link
# amazon.com; scripts/check-amazon.mjs fails the build on any other placement or tag.
#   • To fail-closed (zero amazon.com links): set it empty and redeploy.
PUBLIC_AMAZON_US_TAG=buzzskito200d-20
